    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1"
  },
  "optionalDependencies": {
    "discord.js": "^14.25.1"
  },
  "overrides": {
    "undici": "^7.24.4"
